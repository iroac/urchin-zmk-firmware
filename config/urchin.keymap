#include <dt-bindings/zmk/mouse.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

&mmv {
    time-to-max-speed-ms = <40>;
    acceleration-exponent = <0>;
    delay-ms = <10>;
};

&sk { ignore-modifiers; };

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;

            retro-tap;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;

            retro-tap;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
            hold-trigger-on-release;
        };

        td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPDANCE";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        tb2: doubletap {
            compatible = "zmk,behavior-tap-dance";
            label = "DOUBLETAP";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp ESC>;

            tapping-term-ms = <100>;
        };

        mbk: mbk {
            compatible = "zmk,behavior-tap-dance";
            label = "MBK";
            #binding-cells = <0>;
            bindings = <&kp M>, <&kp BACKSPACE>;

            tapping-term-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        home {
            bindings = <
&kp Q            &kp W            &kp E                &kp R              &kp T               &kp Y      &kp U               &kp I                 &td MINUS O       &kp P
&hml LEFT_GUI A  &hml LEFT_ALT S  &hml LEFT_CONTROL D  &hml LEFT_SHIFT F  &kp G               &kp H      &hmr RIGHT_SHIFT J  &hmr RIGHT_CONTROL K  &hmr RIGHT_ALT L  &hmr RIGHT_WIN SEMICOLON
&kp Z            &kp X            &kp C                &tb2               &kp B               &kp N      &mbk                &td UNDERSCORE COMMA  &td EXCL DOT      &kp SLASH
                                                       &kp SPACE          &td LEFT_SHIFT TAB  &kp ENTER  &to 1
            >;
        };

        nav {
            bindings = <
&trans          &trans        &msc SCRL_LEFT    &msc SCRL_RIGHT  &trans                    &kp K_AGAIN       &mkp LCLK       &mmv MOVE_DOWN  &mmv MOVE_UP  &mkp RCLK
&kt LEFT_WIN    &kt LEFT_ALT  &kt LEFT_CONTROL  &kt LEFT_SHIFT   &kp DEL                   &kp CAPS          &kp LEFT_ARROW  &kp DOWN        &kp UP_ARROW  &kp RIGHT
&msc SCRL_DOWN  &msc SCRL_UP  &mmv MOVE_LEFT    &mmv MOVE_RIGHT  &trans                    &kp INSERT        &kp HOME        &kp PAGE_DOWN   &kt PAGE_UP   &kp END
                                                &to 0            &td LEFT_SHIFT BACKSPACE  &sk LEFT_CONTROL  &to 2
            >;
        };

        symb {
            bindings = <
&kp ESC    &kp AMPERSAND    &kp ASTERISK  &kp PLUS   &kp SINGLE_QUOTE      &kp LEFT_BRACE        &kp LS(AMPERSAND)  &kp LS(ASTERISK)  &kp RIGHT_BRACE        &kp DELETE
&kp TAB    &kp DOLLAR       &kp PERCENT   &kp EQUAL  &kp DOUBLE_QUOTES     &kp LEFT_BRACKET      &kp BACKSLASH      &kp SLASH         &kp RIGHT_BRACKET      &kp ENTER
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH   &kp GRAVE             &kp LEFT_PARENTHESIS  &kp MINUS          &kp PIPE          &kp RIGHT_PARENTHESIS  &to 3
                                          &to 0      &td LSHIFT BACKSPACE  &sk RALT              &to 1
            >;
        };

        configNum {
            bindings = <
&kp C_VOLUME_UP    &kp N7        &kp NUMBER_8  &kp NUMBER_9  &kp LS(MINUS)             &kp F12   &kp F7  &kp F8  &kp F9  &kp C_PLAY
&kp C_VOLUME_DOWN  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp LS(EQUAL)             &kp F11   &kp F4  &kp F5  &kp F6  &kp C_MUTE
&to 2              &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT                   &kp F10   &kp F1  &kp F2  &kp F3  &kp C_PAUSE
                                               &to 0         &td LEFT_SHIFT BACKSPACE  &sk RALT  &to 4
            >;
        };

        bt {
            bindings = <
&trans      &trans      &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans      &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_PRV  &bt BT_NXT  &bt BT_CLR  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                    &to 0   &trans  &trans  &trans
            >;
        };
    };
};

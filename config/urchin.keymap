#include <dt-bindings/zmk/mouse.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

&mmv {
    time-to-max-speed-ms = <20>;
    acceleration-exponent = <0>;
    delay-ms = <0>;
};

&sk { ignore-modifiers; };

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <170>;
            quick-tap-ms = <90>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <170>;
            quick-tap-ms = <90>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };

        td_x_app: td_x_app {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_X_APP";
            #binding-cells = <0>;
            bindings = <&kp X>, <&kp K_APP>;

            tapping-term-ms = <170>;
        };

        td_slash_bslash: td_slash_bslash {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SLSH_BSLS";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp NON_US_BACKSLASH>;

            tapping-term-ms = <170>;
        };

        td_play_stop: td_play_stop {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PLAY_STOP";
            #binding-cells = <0>;
            bindings = <&kp C_PLAY>, <&kp C_STOP>;

            tapping-term-ms = <170>;
        };

        td_zero_minus: td_zero_minus {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ZERO_MINUS";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_0>, <&kp MINUS>;

            tapping-term-ms = <170>;
        };

        td_paren_underscore: td_paren_underscore {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PAREN_UNDERSCORE";
            #binding-cells = <0>;
            bindings = <&kp LS(NUMBER_0)>, <&kp LS(MINUS)>;

            tapping-term-ms = <170>;
        };
    };

    macros {
        m_tab: m_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB>;
        };

        m_quote: m_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>;
        };

        m_delete: m_delete {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DELETE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_tab {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        combo_quote {
            bindings = <&m_quote>;
            key-positions = <8 7>;
        };

        combo_delete {
            bindings = <&m_delete>;
            key-positions = <31 32>;
        };

        combo_fn {
            bindings = <&mo 5>;
            key-positions = <32 33>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q            &kp W            &kp E                &kp R              &kp T      &kp Y        &kp U               &kp I                 &kp O              &kp P
&hml LEFT_GUI A  &hml LEFT_ALT S  &hml LEFT_CONTROL D  &hml LEFT_SHIFT F  &kp G      &kp H        &hmr RIGHT_SHIFT J  &hmr RIGHT_CONTROL K  &hmr RIGHT_ALT L   &hmr RIGHT_WIN SEMICOLON
&kp Z            &td_x_app        &kp C                &kp V              &kp B      &kp N        &kp M               &kp COMMA             &mt RIGHT_ALT DOT  &td_slash_bslash
                                                       &lt 1 SPACE        &lt 2 TAB  &lt 3 ENTER  &lt 4 BACKSPACE
            >;
        };

        nav {
            bindings = <
&none         &none           &msc SCRL_LEFT    &msc SCRL_RIGHT  &none  &kp K_AGAIN    &mkp LCLK  &mmv MOVE_DOWN  &mmv MOVE_UP  &mkp RCLK
&kp LEFT_GUI  &kp LEFT_ALT    &kp LEFT_CONTROL  &kp LEFT_SHIFT   &none  &kp CAPS       &kp LEFT   &kp DOWN        &kp UP        &kp RIGHT
&msc SCRL_UP  &msc SCRL_DOWN  &mmv MOVE_LEFT    &mmv MOVE_RIGHT  &none  &kp INSERT     &kp HOME   &kp PAGE_DOWN   &kp PAGE_UP   &kp END
                                                &none            &none  &kp BACKSPACE  &kp ENTER
            >;
        };

        media {
            bindings = <
&none         &none          &none             &none           &none  &bt BT_CLR    &bt BT_NXT     &bt BT_PRV         &bt BT_SEL 0     &bt BT_SEL 1
&kp LEFT_GUI  &kp LEFT_ALT   &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &out OUT_USB  &kp C_PREV     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT
&none         &kp RIGHT_ALT  &none             &none           &none  &out OUT_BLE  &bt BT_SEL 2   &bt BT_SEL 3       &bt BT_SEL 4     &bt BT_SEL 5
                                               &none           &none  &kp C_MUTE    &td_play_stop
            >;
        };

        num {
            bindings = <
&kp LEFT_BRACKET  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET  &none  &none           &none             &none         &none
&kp SEMICOLON     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL          &none  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI
&kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH      &none  &none           &none             &none         &none
                                              &kp DOT       &td_zero_minus     &none  &none
            >;
        };

        sym {
            bindings = <
&kp LS(LEFT_BRACKET)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(RIGHT_BRACKET)  &none  &none           &none             &none         &none
&kp LS(SEMICOLON)     &kp LS(NUMBER_4)  &kp LS(NUMBER_5)  &kp LS(NUMBER_6)  &kp LS(EQUAL)          &none  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI
&kp LS(GRAVE)         &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(BACKSLASH)      &none  &none           &none             &none         &none
                                                          &kp LS(NUMBER_9)  &td_paren_underscore   &none  &none
            >;
        };

        fn {
            bindings = <
&kp F12  &kp F7  &kp F8  &kp F9     &kp PRINTSCREEN  &none  &none           &none             &none         &none
&kp F11  &kp F4  &kp F5  &kp F6     &kp SCROLLLOCK   &none  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI
&kp F10  &kp F1  &kp F2  &kp F3     &kp PAUSE_BREAK  &none  &none           &none             &none         &none
                         &kp K_APP  &kp SPACE        &none  &none
            >;
        };
    };
};

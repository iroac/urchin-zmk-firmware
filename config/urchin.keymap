#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

&mmv {
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <5>;
};

&sk { ignore-modifiers; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPDANCE";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        tb2: doubletap {
            compatible = "zmk,behavior-tap-dance";
            label = "DOUBLETAP";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp V>, <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        home {
            bindings = <
&kp Q           &kp W           &kp E               &kp R             &kp T          &kp Y      &kp U              &kp I                 &td MINUS O      &kp P
&td LEFT_GUI A  &td LEFT_ALT S  &hm LEFT_CONTROL D  &td LEFT_SHIFT F  &kp G          &kp H      &td RIGHT_SHIFT J  &td RIGHT_CONTROL K   &td RIGHT_ALT L  &td LMETA SEMICOLON
&kp Z           &kp X           &kp C               &tb2              &kt B          &kp N      &kp M              &td UNDERSCORE COMMA  &td EXCL DOT     &kp SLASH
                                                    &mt TAB SPACE     &kp BACKSPACE  &kp ENTER  &to 1
            >;
        };

        nav {
            bindings = <
&trans             &trans           &trans          &trans           &trans          &kp K_AGAIN  &mkp RCLK       &mmv MOVE_DOWN  &mmv MOVE_UP  &mkp LCLK
&kp K_SCROLL_DOWN  &kp K_SCROLL_UP  &mmv MOVE_LEFT  &mmv MOVE_RIGHT  &kp DEL         &kp CAPS     &kp LEFT_ARROW  &kp DOWN        &kp UP_ARROW  &kp RIGHT
&trans             &trans           &trans          &trans           &trans          &kp INSERT   &kp HOME        &kp PAGE_DOWN   &kt PAGE_UP   &kp END
                                                    &to 0            &kp LEFT_SHIFT  &sk RALT     &to 2
            >;
        };

        symb {
            bindings = <
&kp ESC    &kp AMPERSAND    &kp ASTERISK  &kp PLUS   &kp SINGLE_QUOTE   &kp LEFT_BRACE        &kp LS(AMPERSAND)  &kp LS(ASTERISK)  &kp RIGHT_BRACE        &kp DELETE
&kp TAB    &kp DOLLAR       &kp PERCENT   &kp EQUAL  &kp DOUBLE_QUOTES  &kp LEFT_BRACKET      &kp BACKSLASH      &kp SLASH         &kp RIGHT_BRACKET      &kp ENTER
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH   &kp GRAVE          &kp LEFT_PARENTHESIS  &kp MINUS          &kp PIPE          &kp RIGHT_PARENTHESIS  &to 3
                                          &to 0      &kp LSHIFT         &sk RALT              &to 1
            >;
        };

        configNum {
            bindings = <
&kp C_VOLUME_UP    &kp N7        &kp NUMBER_8  &kp NUMBER_9  &kp LS(MINUS)   &kp F12   &kp F7  &kp F8  &kp F9  &kp C_PLAY
&kp C_VOLUME_DOWN  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp LS(EQUAL)   &kp F11   &kp F4  &kp F5  &kp F6  &kp C_MUTE
&to 2              &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT         &kp F10   &kp F1  &kp F2  &kp F3  &kp C_PAUSE
                                               &to 0         &sk LEFT_SHIFT  &sk RALT  &to 4
            >;
        };

        bt {
            bindings = <
&trans      &trans      &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans      &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_PRV  &bt BT_NXT  &bt BT_CLR  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                    &to 0   &trans  &trans  &trans
            >;
        };
    };
};

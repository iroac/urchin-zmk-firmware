#include <dt-bindings/zmk/mouse.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1400
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

&mmv {
    time-to-max-speed-ms = <40>;
    acceleration-exponent = <0>;
    delay-ms = <10>;
};

&sk { ignore-modifiers; };

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };

        td: tapdance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAPDANCE";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        vbs: vbs {
            compatible = "zmk,behavior-tap-dance";
            label = "V_BACKSPACE";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp BACKSPACE>;

            tapping-term-ms = <200>;
        };

        mesc: mesc {
            compatible = "zmk,behavior-tap-dance";
            label = "M_ESC";
            #binding-cells = <0>;
            bindings = <&kp M>, <&kp ESC>;

            tapping-term-ms = <200>;
        };

        zdel: xdel {
            compatible = "zmk,behavior-tap-dance";
            label = "X_DEL";
            #binding-cells = <0>;
            bindings = <&kp Z>, <&kp DEL>;

            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_space {
            bindings = <&kp SPACE>;
            key-positions = <31 20>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <32 29>;
        };

        combo_delete {
            bindings = <&kp DELETE>;
            key-positions = <8 7>;
        };

        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <2 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        home {
            bindings = <
&kp Q            &kp W            &kp E                &kp R              &kp T               &kp Y          &kp U               &kp I                 &td MINUS O       &td SINGLE_QUOTE P
&hml LEFT_GUI A  &hml LEFT_ALT S  &hml LEFT_CONTROL D  &hml LEFT_SHIFT F  &kp G               &kp H          &hmr RIGHT_SHIFT J  &hmr RIGHT_CONTROL K  &hmr RIGHT_ALT L  &hmr RIGHT_WIN SEMICOLON
&kp Z            &kp X            &kp C                &kp V              &kp B               &kp N          &kp M               &td UNDERSCORE COMMA  &td EXCL DOT      &td DOUBLE_QUOTES SLASH
                                                       &kp SPACE          &td LEFT_SHIFT TAB  &kp BACKSPACE  &to 1
            >;
        };

        nav {
            bindings = <
&none         &none           &msc SCRL_LEFT    &msc SCRL_RIGHT  &none               &kp K_AGAIN    &mkp LCLK  &mmv MOVE_DOWN  &mmv MOVE_UP  &mkp RCLK
&kp LEFT_WIN  &kp LEFT_ALT    &kp LEFT_CONTROL  &kp LEFT_SHIFT   &kp DEL             &kp CAPS       &kp LEFT   &kp DOWN        &kp UP        &kp RIGHT
&msc SCRL_UP  &msc SCRL_DOWN  &mmv MOVE_LEFT    &mmv MOVE_RIGHT  &none               &kp INSERT     &kp HOME   &kp PAGE_DOWN   &kp PAGE_UP   &kp END
                                                &to 0            &td LEFT_SHIFT TAB  &kt BACKSPACE  &to 2
            >;
        };

        symb {
            bindings = <
&kp ESC  &kp AMPERSAND    &kp ASTERISK  &kp PLUS   &kp SINGLE_QUOTE  &kp LEFT_BRACE             &kp LS(AMPERSAND)  &kp LS(ASTERISK)  &kp RIGHT_BRACE        &kp DELETE
&kp TAB  &kp DOLLAR       &kp PERCENT   &kp EQUAL  &kp PLUS          &kp LEFT_BRACKET           &kp BACKSLASH      &kp SLASH         &kp RIGHT_BRACKET      &kp ENTER
&to 1    &kp EXCLAMATION  &kp AT_SIGN   &kp HASH   &kp GRAVE         &kp LEFT_PARENTHESIS       &kp MINUS          &kp PIPE          &kp RIGHT_PARENTHESIS  &kp TILDE
                                        &to 0      &kp MINUS         &td RIGHT_SHIFT BACKSPACE  &to 3
            >;
        };

        configNum {
            bindings = <
&kp C_VOLUME_UP    &kp N7        &kp NUMBER_8  &kp NUMBER_9  &kp MINUS                   &kp F12        &kp F7  &kp F8  &kp F9  &kp C_PLAY
&kp C_VOLUME_DOWN  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL                   &kp F11        &kp F4  &kp F5  &kp F6  &kp C_MUTE
&to 2              &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT                     &kp F10        &kp F1  &kp F2  &kp F3  &kp C_PAUSE
                                               &to 0         &td LEFT_SHIFT KP_NUMBER_0  &kp BACKSPACE  &to 4
            >;
        };

        bt {
            bindings = <
&none  &none  &none  &bt BT_CLR  &none  &none  &none  &none  &none  &none
&none  &none  &none  &bt BT_NXT  &none  &none  &none  &none  &none  &none
&none  &none  &none  &bt BT_PRV  &none  &none  &none  &none  &none  &none
                     &to 0       &none  &none  &none
            >;
        };
    };
};
